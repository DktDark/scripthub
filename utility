local function executarTeleporte(cframe)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.CFrame = cframe
    end
end

local function atualizarBindsAtivos()
    for idx, item in ipairs(LocaisSalvos) do
        local actionName = "TP_Action_" .. idx
        ContextActionService:UnbindAction(actionName)

        if item.Key then
            ContextActionService:BindActionAtPriority(
                actionName,
                function(name, state, inputObj)
                    if state == Enum.UserInputState.Begin then
                        executarTeleporte(item.CFrame)
                        return Enum.ContextActionResult.Sink
                    end
                end,
                false,
                3000,
                item.Key
            )
        end
    end
end

