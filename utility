--------------------------------------------------------------------------------
-- DETECÇÃO DE MOBS VIA ATTRIBUTES
--------------------------------------------------------------------------------

-- Verifica se o mob está vivo
local function mobEstaVivo(mob)
    if not mob or not mob.Parent then return false end
    
    -- Checa atributo Dead (prioridade máxima)
    local dead = mob:GetAttribute("Dead")
    if dead == true then return false end
    
    -- Checa HP como fallback
    local hp = mob:GetAttribute("HP")
    if hp and hp <= 0 then return false end
    
    return true
end

-- Pega o nome legível do mob
local function getNomeMob(mob)
    local nome = mob:GetAttribute("Name")
    if nome and nome ~= "" then return nome end
    return mob.Name:sub(1, 8) .. "..."  -- hash truncado
end

-- Retorna todos os mobs válidos de uma pasta, dentro do raio da posição
local function getMobsProximos(pastaNome, posicao)
    local mobs = {}
    local pastaServer = workspace:FindFirstChild("_ENEMIES")
    if not pastaServer then return mobs end
    pastaServer = pastaServer:FindFirstChild("Server")
    if not pastaServer then return mobs end
    local pastaMapa = pastaServer:FindFirstChild(pastaNome)
    if not pastaMapa then return mobs end

    for _, mob in ipairs(pastaMapa:GetChildren()) do
        if mob:IsA("Part") and mobEstaVivo(mob) then
            local dist = (mob.Position - posicao).Magnitude
            if dist <= RaioDeteccao then
                table.insert(mobs, mob)
            end
        end
    end
    return mobs
end

-- Espera aparecer pelo menos 1 mob na área
local function esperarMobAparecer(pastaNome, posicao, timeout)
    local tempoInicio = tick()
    while tick() - tempoInicio < timeout do
        if not FarmAtivo then return {} end
        local mobs = getMobsProximos(pastaNome, posicao)
        if #mobs > 0 then return mobs end
        task.wait(0.2)
    end
    return {}
end

-- Espera todos os mobs morrerem (via atributo Dead)
local function esperarMobsMorrerem(mobsIniciais, timeout)
    if #mobsIniciais == 0 then return 0 end

    local tempoInicio = tick()
    local matouCount = 0
    local vivos = {}
    for _, mob in ipairs(mobsIniciais) do
        vivos[mob] = true
    end

    while tick() - tempoInicio < timeout do
        if not FarmAtivo then return matouCount end

        local todosMortos = true
        for mob in pairs(vivos) do
            if not mobEstaVivo(mob) then
                vivos[mob] = nil
                matouCount = matouCount + 1
            else
                todosMortos = false
            end
        end

        if todosMortos then return matouCount end
        task.wait(0.15)
    end

    return matouCount
end

--------------------------------------------------------------------------------
-- LOOP PRINCIPAL DO AUTO-FARM
--------------------------------------------------------------------------------
local function executarAutoFarm()
    task.spawn(function()
        while FarmAtivo do
            local algumTeleportExecutado = false

            for _, mapa in ipairs(MapasConfig) do
                for idx, pos in ipairs(mapa.Posicoes) do
                    if not FarmAtivo then break end

                    local key = mapa.Nome .. "_" .. idx
                    if PosicoesSelecionadas[key] then
                        algumTeleportExecutado = true

                        -- ===== VERIFICA PERSONAGEM =====
                        local char = LocalPlayer.Character
                        local root = char and char:FindFirstChild("HumanoidRootPart")
                        local humanoid = char and char:FindFirstChildOfClass("Humanoid")

                        if not root or not humanoid or humanoid.Health <= 0 then
                            statusLabel.Text = "⏳ Aguardando respawn..."
                            statusLabel.TextColor3 = Color3.fromRGB(255, 150, 100)
                            while FarmAtivo do
                                task.wait(0.5)
                                char = LocalPlayer.Character
                                root = char and char:FindFirstChild("HumanoidRootPart")
                                humanoid = char and char:FindFirstChildOfClass("Humanoid")
                                if root and humanoid and humanoid.Health > 0 then break end
                            end
                            if not FarmAtivo then break end
                        end

                        -- ===== TELEPORTE =====
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                        root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))

                        statusLabel.Text = string.format("📍 %s (Pos %d) - Buscando mobs...", mapa.Nome, idx)
                        statusLabel.TextColor3 = Color3.fromRGB(100, 200, 255)

                        -- ===== ESPERA SPAWN =====
                        local mobs = esperarMobAparecer(mapa.Pasta, pos, TimeoutSpawn)

                        if #mobs > 0 then
                            -- Mostra nomes dos mobs detectados (até 3)
                            local nomes = {}
                            for i = 1, math.min(3, #mobs) do
                                table.insert(nomes, getNomeMob(mobs[i]))
                            end
                            local nomesStr = table.concat(nomes, ", ")
                            if #mobs > 3 then nomesStr = nomesStr .. " +" .. (#mobs - 3) end

                            statusLabel.Text = string.format("⚔️ %s (Pos %d) - %d mob(s): %s",
                                mapa.Nome, idx, #mobs, nomesStr)
                            statusLabel.TextColor3 = Color3.fromRGB(255, 220, 100)

                            -- ===== ESPERA MORTE =====
                            local kills = esperarMobsMorrerem(mobs, TimeoutMorte)
                            TotalKills = TotalKills + kills
                            killsLabel.Text = "Kills: " .. TotalKills

                            statusLabel.Text = string.format("✅ %s (Pos %d) - +%d kills! Próxima...",
                                mapa.Nome, idx, kills)
                            statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
                        else
                            statusLabel.Text = string.format("⚠️ %s (Pos %d) - Nenhum mob",
                                mapa.Nome, idx)
                            statusLabel.TextColor3 = Color3.fromRGB(255, 180, 80)
                        end

                        -- Delay entre posições (curto, pois já esperou morte)
                        if DelayTeleport > 0 then
                            task.wait(DelayTeleport * (0.85 + math.random() * 0.3))
                        end
                    end
                end
                if not FarmAtivo then break end
            end

            if not algumTeleportExecutado then
                statusLabel.Text = "⚠️ Nenhuma posição selecionada!"
                statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                task.wait(1)
            end
        end

        statusLabel.Text = "Status: Parado | Anti-AFK: Ativo"
        statusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    end)
end

-- Controle da thread de farm (evita múltiplas threads simultâneas)
local farmThread = nil

toggleFarmBtn.MouseButton1Click:Connect(function()
    FarmAtivo = not FarmAtivo

    if FarmAtivo then
        toggleFarmBtn.Text = "DESLIGAR FARM"
        toggleFarmBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        farmThread = task.spawn(executarAutoFarm)
    else
        toggleFarmBtn.Text = "LIGAR FARM"
        toggleFarmBtn.BackgroundColor3 = Color3.fromRGB(40, 140, 40)
        if farmThread then
            task.cancel(farmThread)
            farmThread = nil
        end
    end
end)
