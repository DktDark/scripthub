        local nome = inputNomeLocal.Text ~= "" and inputNomeLocal.Text or ("Local " .. (#LocaisSalvos + 1))
        table.insert(LocaisSalvos, {
            Nome = nome,
            CFrame = root.CFrame,
            Key = nil,
            KeyName = nil
        })
        inputNomeLocal.Text = ""
        atualizarListaUI()
    end
end)

LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.7)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.PlatformStand = false
        if char:FindFirstChild("Animate") then char.Animate.Disabled = false end
    end
end)
