-- GERENCIADOR DE CAPTURA DE BIND (TP + FLY)
--------------------------------------------------------------------------------
local function definirBindFly(key, name)
    flyKey = key
    flyKeyName = name
    btnBindFly.Text = "BIND FLY: " .. name
    btnBindFly.BackgroundColor3 = Color3.fromRGB(110, 60, 180)

    ContextActionService:UnbindAction("Fly_Action")
    ContextActionService:BindActionAtPriority(
        "Fly_Action",
        function(actionName, inputState, inputObject)
            if inputState == Enum.UserInputState.Begin then
                toggleFly()
                return Enum.ContextActionResult.Sink
            end
        end,
        false,
        3000,
        flyKey
    )
end

local function iniciarCapturaBind(alvo)
    esperandoBindPara = alvo
    
    ContextActionService:BindActionAtPriority(
        "TempBindCapture",
        function(actionName, inputState, inputObject)
            if inputState == Enum.UserInputState.Begin and esperandoBindPara then
                local key = inputObject.UserInputType
                local name = ""

                if key == Enum.UserInputType.MouseButton4 then
                    name = "M_Button4"
                elseif key == Enum.UserInputType.MouseButton5 then
                    name = "M_Button5"
                elseif key == Enum.UserInputType.MouseButton3 then
                    name = "M_Wheel"
                end

                if name ~= "" then
                    if esperandoBindPara == "FLY" then
                        definirBindFly(key, name)
                    else
                        esperandoBindPara.Key = key
                        esperandoBindPara.KeyName = name
                        atualizarListaUI()
                    end
                    esperandoBindPara = nil
                    ContextActionService:UnbindAction("TempBindCapture")
                    return Enum.ContextActionResult.Sink
                end
            end
        end,
        false,
        10000,
        Enum.UserInputType.MouseButton3,
        Enum.UserInputType.MouseButton4,
        Enum.UserInputType.MouseButton5
    )
end

btnBindFly.MouseButton1Click:Connect(function()
    btnBindFly.Text = "Pressione..."
    iniciarCapturaBind("FLY")
end)

-- Capturar Teclas do Teclado durante o BIND
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if esperandoBindPara and input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode ~= Enum.KeyCode.Escape then
            if esperandoBindPara == "FLY" then
                definirBindFly(input.KeyCode, input.KeyCode.Name)
            else
                esperandoBindPara.Key = input.KeyCode
                esperandoBindPara.KeyName = input.KeyCode.Name
                atualizarListaUI()
            end
            esperandoBindPara = nil
            ContextActionService:UnbindAction("TempBindCapture")
        end
    end
end)

