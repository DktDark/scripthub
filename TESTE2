            task.wait(SavedTPDelay)
            teleportSavedPos()
        else
            task.wait(0.3)
        end
    end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == SavedTPBind then
        teleportSavedPos()
    end
end)

