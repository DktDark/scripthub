--==================================================
-- Fly Script (adicionado na aba Combat)
-- Correções aplicadas:
-- * substituí 'False' por 'false' (lua)
-- * BodyVelocity.MaxForce = math.huge para garantir força suficiente
-- * Normalize + prevenção de multiplicação diagonal descontrolada
-- * Disconnect/cleanup corretos no respawn
-- * Uso de UIS.InputBegan para bind da tecla F
--==================================================

local Fly = {
    enabled = false,
    speed = 100,
    bodyVelocity = nil,
    renderConn = nil,
    inputConn = nil
}

-- Slider para ajustar a velocidade do fly (valor inicial 100)
TabCombat:CreateSlider({
    Name = "Fly Speed",
    Min = 1,
    Max = 2000,
    CurrentValue = Fly.speed,
    Increment = 1,
    Suffix = "speed",
    Callback = function(v)
        Fly.speed = v
    end
})

local function startFly()
    if Fly.enabled then return end
    Fly.enabled = true

    local character = getCharacter()
    if not character then return end
    local hrp = character:WaitForChild("HumanoidRootPart", 2)
    if not hrp then return end

    -- criar BodyVelocity (força alta para evitar limitação)
    if Fly.bodyVelocity then
        Fly.bodyVelocity:Destroy()
        Fly.bodyVelocity = nil
    end

    local bv = Instance.new("BodyVelocity")
    bv.Name = "Fly_BodyVelocity"
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.Parent = hrp
    Fly.bodyVelocity = bv

    -- RenderStepped para atualizar a direção com a câmera e as teclas WASD
    if Fly.renderConn then
        Fly.renderConn:Disconnect()
        Fly.renderConn = nil
    end

    Fly.renderConn = RunService.RenderStepped:Connect(function()
        if not Fly.enabled or not Fly.bodyVelocity then return end

        local moveDirection = Vector3.new(0, 0, 0)
        local cam = workspace.CurrentCamera
        if not cam then return end

        if UIS:IsKeyDown(Enum.KeyCode.W) then
            moveDirection = moveDirection + (cam.CFrame.LookVector)
        end
        if UIS:IsKeyDown(Enum.KeyCode.S) then
            moveDirection = moveDirection - (cam.CFrame.LookVector)
        end
        if UIS:IsKeyDown(Enum.KeyCode.A) then
            moveDirection = moveDirection - (cam.CFrame.RightVector)
        end
        if UIS:IsKeyDown(Enum.KeyCode.D) then
            moveDirection = moveDirection + (cam.CFrame.RightVector)
        end

        -- Normalizar para evitar ganho de velocidade na diagonal
        if moveDirection.Magnitude > 0 then
            moveDirection = moveDirection.Unit * Fly.speed
        else
            moveDirection = Vector3.new(0, 0, 0)
        end

        -- Aplicar velocidade
        Fly.bodyVelocity.Velocity = moveDirection
    end)
end

local function stopFly()
    Fly.enabled = false
    if Fly.renderConn then
        Fly.renderConn:Disconnect()
        Fly.renderConn = nil
    end
    if Fly.bodyVelocity then
        Fly.bodyVelocity:Destroy()
        Fly.bodyVelocity = nil
    end
end

-- Botão na UI para alternar fly
TabCombat:CreateButton({
    Name = "Toggle Fly (F)",
    Callback = function()
        if Fly.enabled then
            stopFly()
        else
            startFly()
        end
    end
})

-- Bind / Tecla F para alternar o fly (InputBegan)
-- Mantemos gameProcessed check para evitar interferir com typing/GUI
if Fly.inputConn then
    Fly.inputConn:Disconnect()
    Fly.inputConn = nil
end

Fly.inputConn = UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.F then
        if Fly.enabled then
            stopFly()
        else
            startFly()
        end
    end
end)

