--==================================================
-- LOCK DE POSIÇÃO (IGUAL AO ORIGINAL)
--==================================================

local function clearLock(hrp)
    for _, v in ipairs(hrp:GetChildren()) do
        if v.Name:find("TP") then
            v:Destroy()
        end
    end
end

local function enableLock(cf)
    local hrp = getHRP(getCharacter())
    if not hrp then return end

    clearLock(hrp)

    local att = Instance.new("Attachment", hrp)
    att.Name = "TP_ATTACH"

    local ap = Instance.new("AlignPosition", hrp)
    ap.Name = "TP_ALIGN_POS"
    ap.Attachment0 = att
    ap.Mode = Enum.PositionAlignmentMode.OneAttachment
    ap.Position = cf.Position
    ap.MaxForce = math.huge
    ap.Responsiveness = 200
    ap.RigidityEnabled = true

    local ao = Instance.new("AlignOrientation", hrp)
    ao.Name = "TP_ALIGN_ORI"
    ao.Attachment0 = att
    ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
    ao.CFrame = cf * CFrame.Angles(math.rad(-65), 0, 0)
    ao.MaxTorque = math.huge
    ao.Responsiveness = 200
    ao.RigidityEnabled = true

    hrp.CFrame = cf
end

local function updateLock(cf)
    local hrp = getHRP(getCharacter())
    if not hrp then return end

    local ap = hrp:FindFirstChild("TP_ALIGN_POS")
    local ao = hrp:FindFirstChild("TP_ALIGN_ORI")

    if ap then ap.Position = cf.Position end
    if ao then ao.CFrame = cf * CFrame.Angles(math.rad(-65), 0, 0) end
end

local function disableLock()
    local hrp = getHRP(getCharacter())
    if hrp then clearLock(hrp) end
end

--==================================================
-- MOB (MODIFICADO PARA ENCONTRAR POR ID)
--==================================================

local function isValidMob(id)
    return MobStates[id] and MobStates[id].enabled
end

local function findNearestMob()
    local hrp = getHRP(getCharacter())
    if not hrp then return nil end

    local closest, dist = nil, math.huge

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model")
        and isValidMob(obj.Name)
        and isAlive(obj) then

            local mobHRP = getHRP(obj)
            if mobHRP then
                local d = (hrp.Position - mobHRP.Position).Magnitude
                if d < dist then
                    dist = d
                    closest = obj
                end
            end
        end
    end

    return closest
end

local function teleportToMob(mob)
    local mobHRP = getHRP(mob)
    if not mobHRP then return end

    local cf = mobHRP.CFrame + TELEPORT_OFFSET
    enableLock(cf)
    updateLock(cf)
end

--==================================================
-- LOOP AUTO TP (ORIGINAL)
--==================================================

local function startLoop()
    if loopRunning then return end
    loopRunning = true

    task.spawn(function()
        while enabled do
            if not currentTarget or not isAlive(currentTarget) then
                currentTarget = findNearestMob()
            end

            if currentTarget then
                teleportToMob(currentTarget)
            end

            task.wait(TELEPORT_DELAY)
        end
        loopRunning = false
    end)
end

--==================================================
-- FLY (INDEPENDENTE)
--==================================================

local FlyEnabled = false
local FlySpeed = 60
local FlyBind = Enum.KeyCode.F

local flyBV, flyBG, flyConn

local function startFly()
    local hrp = getHRP(getCharacter())
    if not hrp then return end

    flyBV = Instance.new("BodyVelocity", hrp)
    flyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)

    flyBG = Instance.new("BodyGyro", hrp)
    flyBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)

    flyConn = RunService.RenderStepped:Connect(function()
        if not FlyEnabled then return end

        local cam = workspace.CurrentCamera
        local dir = Vector3.zero

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0,1,0) end

        flyBV.Velocity = dir.Magnitude > 0 and dir.Unit * FlySpeed or Vector3.zero
        flyBG.CFrame = cam.CFrame
    end)
end

local function stopFly()
    if flyConn then flyConn:Disconnect() end
    if flyBV then flyBV:Destroy() end
    if flyBG then flyBG:Destroy() end
end

--==================================================
-- AUTO SKILL (MANTIDO)
--==================================================

local AutoSkill = true
local ATTACK_DELAY = 0.15
local attacking = false
local usingSkills = false

local function equipTool()
    local char = getCharacter()
    if char:FindFirstChildOfClass("Tool") then return end

    local bp = player:FindFirstChildOfClass("Backpack")
    if bp then
        local tool = bp:FindFirstChildOfClass("Tool")
        if tool then tool.Parent = char end
    end
end

local function autoAttack()
    if attacking then return end
    attacking = true

    task.spawn(function()
        while AutoSkill do
            equipTool()
            local tool = getCharacter():FindFirstChildOfClass("Tool")
            if tool then pcall(function() tool:Activate() end) end
            task.wait(ATTACK_DELAY)
        end
        attacking = false
    end)
end

local function autoSkills()
    if usingSkills then return end
    usingSkills = true

    task.spawn(function()
        while AutoSkill do
            for _, key in ipairs({
                Enum.KeyCode.E,
                Enum.KeyCode.R,
                Enum.KeyCode.T
            }) do
                VirtualInputManager:SendKeyEvent(true, key, false, game)
                VirtualInputManager:SendKeyEvent(false, key, false, game)
                task.wait()
            end
        end
        usingSkills = false
    end)
end

