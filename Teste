-- LÓGICA DAS ABAS E SELEÇÃO DE POSIÇÕES
--------------------------------------------------------------------------------
local mapaAtivoIndex = 1
local mapButtons = {}

local function renderizarPosicoes()
    for _, child in pairs(posContainer:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local mapaAtual = MapasConfig[mapaAtivoIndex]
    if not mapaAtual then return end

    for idx, pos in ipairs(mapaAtual.Posicoes) do
        local key = mapaAtual.Nome .. "_" .. idx
        local isSelected = PosicoesSelecionadas[key] or false

        local btn = Instance.new("TextButton")
        btn.Text = string.format("Pos %d %s", idx, isSelected and "✔" or "")
        btn.BackgroundColor3 = isSelected and Color3.fromRGB(30, 100, 180) or Color3.fromRGB(45, 45, 50)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.SourceSansBold
        btn.TextSize = 13
        btn.Parent = posContainer

        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 6)
        btnCorner.Parent = btn

        btn.MouseButton1Click:Connect(function()
            PosicoesSelecionadas[key] = not PosicoesSelecionadas[key]
            renderizarPosicoes()
        end)
    end
end

-- Gerar abas dinamicamente para os mapas
for idx, mapa in ipairs(MapasConfig) do
    local mapBtn = Instance.new("TextButton")
    mapBtn.Size = UDim2.new(0, 85, 1, 0)
    mapBtn.Text = mapa.Nome
    mapBtn.BackgroundColor3 = (idx == 1) and Color3.fromRGB(0, 120, 215) or Color3.fromRGB(45, 45, 50)
    mapBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    mapBtn.Font = Enum.Font.SourceSansBold
    mapBtn.TextSize = 12
    mapBtn.Parent = tabContainer

    local mapCorner = Instance.new("UICorner")
    mapCorner.CornerRadius = UDim.new(0, 6)
    mapCorner.Parent = mapBtn

    mapButtons[idx] = mapBtn

    mapBtn.MouseButton1Click:Connect(function()
        mapaAtivoIndex = idx
        for i, mBtn in pairs(mapButtons) do
            mBtn.BackgroundColor3 = (i == mapaAtivoIndex) and Color3.fromRGB(0, 120, 215) or Color3.fromRGB(45, 45, 50)
        end
        renderizarPosicoes()
    end)
end

renderizarPosicoes()

--------------------------------------------------------------------------------
-- LÓGICA DO AUTO-FARM
--------------------------------------------------------------------------------
local function executarAutoFarm()
    task.spawn(function()
        while FarmAtivo do
            local algumTeleportExecutado = false

            for _, mapa in ipairs(MapasConfig) do
                for idx, pos in ipairs(mapa.Posicoes) do
                    if not FarmAtivo then break end

                    local key = mapa.Nome .. "_" .. idx
                    if PosicoesSelecionadas[key] then
                        algumTeleportExecutado = true
                        
                        local char = LocalPlayer.Character
                        local root = char and char:FindFirstChild("HumanoidRootPart")

                        if root then
                            -- Zera as velocidades para evitar que o impulso jogue o personagem longe
                            root.AssemblyLinearVelocity = Vector3.zero
                            root.AssemblyAngularVelocity = Vector3.zero
                            
                            -- Aplica o Teleporte com ajuste de elevação de +3 para não spawnar no chão
                            root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
                            
                            statusLabel.Text = string.format("Teleportado: %s (Pos %d)", mapa.Nome, idx)
                            statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
                        else
                            statusLabel.Text = "Aguardando personagem..."
                            statusLabel.TextColor3 = Color3.fromRGB(255, 150, 100)
                        end

                        task.wait(DelayTeleport)
                    end
                end
                if not FarmAtivo then break end
            end

            if not algumTeleportExecutado then
                statusLabel.Text = "Nenhuma posição selecionada!"
                statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                task.wait(1)
            end
        end

        statusLabel.Text = "Status: Parado"
        statusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    end)
end

toggleFarmBtn.MouseButton1Click:Connect(function()
    FarmAtivo = not FarmAtivo

    if FarmAtivo then
        toggleFarmBtn.Text = "DESLIGAR FARM"
        toggleFarmBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        executarAutoFarm()
    else
        toggleFarmBtn.Text = "LIGAR FARM"
        toggleFarmBtn.BackgroundColor3 = Color3.fromRGB(40, 140, 40)
    end
end)
