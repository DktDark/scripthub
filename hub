getgenv().BridgeNetWorld1ID = getgenv().BridgeNetWorld1ID or "{"
getgenv().BridgeNetWorld4ID = getgenv().BridgeNetWorld4ID or "&"
getgenv().BridgeNetStarID = getgenv().BridgeNetStarID or "a"
if not getgenv().BridgeNetHookLoaded then
    getgenv().BridgeNetHookLoaded = true
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        if self.Name == "dataRemoteEvent" and method == "FireServer" then
            if type(args[1]) == "table" and args[1][1] and args[1][1]["__BridgeTuplePayload__"] then
                local payload = args[1][1]["Payload"]
                local liveID = args[1][2]
                if payload and liveID then
                    if payload[1] == "Create" then
                        if payload[2] == "World1" and liveID ~= getgenv().BridgeNetWorld1ID then
                            getgenv().BridgeNetWorld1ID = liveID
                        elseif payload[2] == "World4" and liveID ~= getgenv().BridgeNetWorld4ID then
                            getgenv().BridgeNetWorld4ID = liveID
                        end
                    elseif payload[1] == getgenv().starname and liveID ~= getgenv().BridgeNetStarID then
                        getgenv().BridgeNetStarID = liveID
                    end
                end
            end
        end
        return oldNamecall(self, ...)
    end)
end
