--// SERVICES
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local HRP = Character:WaitForChild("HumanoidRootPart")

--// FLUENT UI
local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
local SaveManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/SaveManager.lua"))()
local InterfaceManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/InterfaceManager.lua"))()

--// VARIABLES
local AutoFarm = false
local SelectedMobs = {}
local FarmMethod = "Teleport"
local TeleportDelay = 0.2
local EnemiesFolder = Workspace:WaitForChild("Enemies")

--// WINDOW
local Window = Fluent:CreateWindow({
    Title = "Security Test - Auto Farm",
    SubTitle = "Anti-Cheat Testing",
    Size = UDim2.fromOffset(580,460),
    Theme = "Dark",
    TabWidth = 160
})

local Tab = Window:AddTab({
    Title = "Auto Farm",
    Icon = "sword"
})

--// GET UNIQUE MOB NAMES
local function GetMobList()
    local List = {}
    local Added = {}

    for _, mob in pairs(EnemiesFolder:GetChildren()) do
        if mob:FindFirstChild("Humanoid") then
            if not Added[mob.Name] then
                Added[mob.Name] = true
                table.insert(List, mob.Name)
            end
        end
    end

    return List
end

--// DROPDOWN MULTI
local EnemyDropdown = Tab:AddDropdown("EnemySelect", {
    Title = "Select Mobs",
    Values = GetMobList(),
    Multi = true,
    Default = {}
})

EnemyDropdown:OnChanged(function(val)
    SelectedMobs = val
end)

--// REFRESH BUTTON
Tab:AddButton({
    Title = "Refresh Enemies",
    Callback = function()
        EnemyDropdown:SetValues(GetMobList())
        Fluent:Notify({
            Title = "Refreshed",
            Content = "Enemy list rebuilt.",
            Duration = 3
        })
    end
})

--// FARM METHOD
local MethodDropdown = Tab:AddDropdown("FarmMethod", {
    Title = "Farm Method",
    Values = {"Teleport", "Walk To"},
    Default = "Teleport"
})

MethodDropdown:OnChanged(function(val)
    FarmMethod = val
end)

--// TELEPORT DELAY
local DelayDropdown = Tab:AddDropdown("TeleportDelay", {
    Title = "Teleport Delay",
    Values = {"0.05","0.1","0.2","0.5","1","2"},
    Default = "0.2"
})

DelayDropdown:OnChanged(function(val)
    TeleportDelay = tonumber(val)
end)

--// GET TARGET
local function GetTarget()
    for _, mob in pairs(EnemiesFolder:GetChildren()) do
        if table.find(SelectedMobs, mob.Name) then
            if mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                return mob
            end
        end
    end
end

--// MAIN LOOP
local function StartFarm()
    task.spawn(function()
        while AutoFarm do
            local target = GetTarget()

            if target and target:FindFirstChild("HumanoidRootPart") then
                local targetHRP = target.HumanoidRootPart

                if FarmMethod == "Teleport" then
                    -- Instant teleport (highly detectable)
                    HRP.CFrame = targetHRP.CFrame * CFrame.new(0,0,-3)
                else
                    -- MoveTo natural movement
                    Humanoid:MoveTo(targetHRP.Position)
                end
            end

            task.wait(TeleportDelay)
        end
    end)
end

--// TOGGLE
Tab:AddToggle("AutoFarmToggle", {
    Title = "Auto Farm",
    Default = false,
    Callback = function(val)
        AutoFarm = val
        if val then
            StartFarm()
        end
    end
})
